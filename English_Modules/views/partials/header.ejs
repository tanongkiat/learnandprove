<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · TriamQuest 90</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">TriamQuest 90</a>
    <nav>
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
      <a href="/training" class="<%= currentPath.startsWith('/training') ? 'active' : '' %>">Training</a>
      <a href="/practice" class="<%= currentPath.startsWith('/practice') ? 'active' : '' %>">Practice</a>
      <a href="/mock" class="<%= currentPath.startsWith('/mock') ? 'active' : '' %>">Mock Exam</a>
      <a href="/skill-map" class="<%= currentPath.startsWith('/skill-map') ? 'active' : '' %>">Skill Map</a>
      <a href="/error-notebook" class="<%= currentPath.startsWith('/error-notebook') ? 'active' : '' %>">Error Notebook</a>
      <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
        <a href="/admin" class="<%= currentPath.startsWith('/admin') ? 'active' : '' %>">Admin</a>
      <% } %>
    </nav>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <form method="post" action="/logout" class="user-badge">
        <span><%= currentUser.name %></span>
        <button class="btn btn-secondary" type="submit">Log out</button>
      </form>
    <% } %>
  </header>
  <main class="container">
