<%- include('../partials/header', { title }) %>

<h1>Mission Complete</h1>

<div class="hero-card">
  <div class="hero-stats">
    <div class="stat"><span class="stat-value"><%= summary.correctCount %>/<%= summary.totalCount %></span><span class="stat-label">correct</span></div>
    <div class="stat"><span class="stat-value">+<%= summary.xpGain %></span><span class="stat-label">XP earned</span></div>
    <div class="stat"><span class="stat-value">🔥 <%= summary.streak %></span><span class="stat-label">day streak</span></div>
  </div>
  <a class="btn btn-primary" href="/practice">Next Mission</a>
  <a class="btn btn-secondary" href="/">Back Home</a>
</div>

<% summary.results.forEach(function(r, i) { %>
  <%- include('../partials/result', { r, index: i + 1 }) %>
<% }) %>

<%- include('../partials/footer') %>
